{
  "name": "gameshow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:barter-precomputed": "tsx scripts/build_barter_precomputed.ts",
    "build:bridges-pack": "tsx scripts/build_bridges_pack.ts",
    "build:postmark-pack": "tsx scripts/build_postmark_pack.ts",
    "build:dawn-cabinet-schedule": "tsx scripts/build_dawn_cabinet_schedule.ts",
    "build:kilter-pack": "python3 scripts/build_kilter_pack.py",
    "audit:kilter-pack": "python3 scripts/build_kilter_pack.py --audit-only",
    "review:kilter-editorial": "python3 scripts/review_kilter_editorial.py",
    "build:liberties-pack": "tsx scripts/build_liberties_pack.ts",
    "audit:liberties-pack": "tsx scripts/audit_liberties_pack.ts",
    "audit:liberties-personas": "tsx scripts/audit_liberties_personas.ts",
    "compare:liberties-pack": "tsx scripts/compare_liberties_packs.ts",
    "build:wordie-schedule": "python3 scripts/build_wordie_schedule.py",
    "build:mini-crossword-bank": "python3 scripts/build_mini_crossword_bank.py",
    "build:mini-crossword-seeds": "python3 scripts/build_mini_crossword_variants.py",
    "sync:trivia-telemetry": "tsx scripts/fetch_trivia_telemetry_snapshot.ts",
    "build:museum-candidates": "python3 scripts/build_museum_candidates.py",
    "build:museum-editorial-bank": "python3 scripts/build_museum_editorial_bank.py --approved-target 365 --start 2026-07-01",
    "build:museum-frames": "python3 scripts/build_museum_frames.py",
    "cache:museum-images": "python3 scripts/cache_museum_images.py",
    "build:museum-schedule": "python3 scripts/build_museum_schedule.py --start 2026-07-01 --days 365",
    "build:museum-rest-of-year": "python3 scripts/build_museum_schedule.py --start 2026-07-01 --through 2026-12-31",
    "build:museum-annual-pack": "python3 scripts/build_museum_editorial_bank.py --approved-target 365 --start 2026-07-01 && python3 scripts/build_museum_schedule.py --start 2026-07-01 --days 365",
    "rewrite:museum-evidence-first": "python3 scripts/rewrite_museum_evidence_first.py --days 365 --require-clean-first-30 --write-report",
    "rewrite:museum-evidence-first:calibration": "python3 scripts/rewrite_museum_evidence_first.py --days 30 --write-report",
    "review:museum-curator-source": "python3 scripts/curator_review_museum_facts.py --write-report",
    "review:museum-curator-line": "python3 scripts/curator_line_review_museum_facts.py --write-report",
    "validate:museum": "python3 scripts/validate_museum_editorial_bank.py",
    "audit:museum": "python3 scripts/audit_museum_quality.py",
    "audit:museum-editorial-product": "python3 scripts/audit_museum_editorial_product.py",
    "audit:museum:write": "python3 scripts/audit_museum_quality.py --write-report docs/museum-365-polish-report.md --write-showcase-tracker docs/museum-365-showcase-tracker.md --schedule-regenerated",
    "build:sudoku-pack": "python3 scripts/build_sudoku_pack.py",
    "audit:sudoku-pack": "python3 scripts/build_sudoku_pack.py --audit-only",
    "audit:ballpark": "npx tsx scripts/ballpark_content_qa.ts",
    "audit:ballpark:json": "npx tsx scripts/ballpark_content_qa.ts --json",
    "draft:moji-mash": "python3 scripts/generate_moji.py",
    "inspect:barter": "node --experimental-strip-types scripts/inspect_barter.ts",
    "moji-schedule": "python3 scripts/show_schedule.py",
    "moji-calendar": "python3 scripts/show_calendar.py",
    "barter:decision-tree": "node --experimental-strip-types scripts/barter-decision-tree.ts",
    "build:dawn-art": "python3 scripts/build_dawn_tile_assets.py",
    "prepare:dawn-art": "python3 scripts/generate_dawn_tile_art.py prepare",
    "generate:dawn-art": "python3 scripts/generate_dawn_tile_art.py generate",
    "accept:dawn-art": "python3 scripts/generate_dawn_tile_art.py accept",
    "extract:dawn-art": "python3 scripts/extract_dawn_tile_contact_sheet.py",
    "preview:dawn-art": "tsx scripts/dawn_tile_art_contact_sheet.ts",
    "preview:dawn-art-html": "tsx scripts/dawn_tile_art_gallery.ts",
    "threadline:review": "node --experimental-strip-types scripts/review_threadline_calendar.ts",
    "threadline:editorial-team": "node --experimental-strip-types scripts/review_threadline_editorial_team.ts --write=docs/threadline-editorial-team-review.md",
    "build:threadline-runtime": "node --experimental-strip-types scripts/build_threadline_runtime_pack.ts",
    "build:threadline-backend-pack": "node --experimental-strip-types scripts/build_threadline_backend_pack.ts",
    "test": "vitest run",
    "test:barter": "vitest run src/data/barter/*.test.ts",
    "studio": "cd tools/moji-mash-studio && npm run dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "expo": "~54.0.33",
    "expo-constants": "^18.0.13",
    "expo-linking": "^8.0.11",
    "expo-router": "^6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  },
  "private": true
}
